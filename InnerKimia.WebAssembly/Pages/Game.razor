@page "/"
@using InnerKimia.Application.DTOs
@using InnerKimia.Application.Interfaces
@using static InnerKimia.WebAssembly.Pages.StonedCardsPanel
@using static InnerKimia.WebAssembly.Pages.GameBoard

@inject IGameService GameService

<div class="game-container">
    <h1 class="game-title">🔬 کیمیای درون 🧪</h1>
    
    @if (IsLoading)
    {
        <div class="loading">در حال بارگذاری...</div>
    }
    else if (GameState == null)
    {
        <div class="start-screen">
            <p>به بازی عناصر خوش آمدید!</p>
            <button class="btn btn-primary" @onclick="StartNewGame">
                🎮 شروع بازی جدید
            </button>
        </div>
    }
    else
    {
        <GameStatus GameState="GameState" />
        
        <div class="game-area">
            <div class="board-section">
                <GameBoard GameState="GameState" 
                           SelectedCardId="SelectedCardId"
                           OnCellClicked="HandleCellClick" />
                <GameControls GameState="GameState" 
                       OnNewGame="StartNewGame"
                       OnClearData="ClearSavedData" />
            </div>
            
            <div class="side-panel">
                <PlayerHand GameState="GameState" 
                            SelectedCardId="SelectedCardId"
                            OnCardSelected="HandleCardSelected" />

                <StonedCardsPanel GameState="GameState" 
                                  OnRemoveStone="HandleRemoveStone" />
                
            </div>
        </div>
        
        <GameMessages Messages="Messages" />
    }
</div>

@code {
    private GameStateDto? GameState;
    private Guid? SelectedCardId;
    private List<string> Messages = new();
    private bool IsLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadGameAsync();
    }

    private async Task LoadGameAsync()
    {
        IsLoading = true;
        try
        {
            GameState = await GameService.GetGameStateAsync();
            AddMessage("بازی قبلی بارگذاری شد.");
        }
        catch
        {
            GameState = null;
        }
        IsLoading = false;
    }

    private async Task StartNewGame()
    {
        IsLoading = true;
        try
        {
            GameState = await GameService.StartNewGameAsync();
            SelectedCardId = null;
            Messages.Clear();
            AddMessage("🎯 بازی جدید شروع شد! اولین کارت را در مرکز قرار دهید.");
        }
        catch (Exception ex)
        {
            AddMessage($"❌ خطا: {ex.Message}");
        }
        IsLoading = false;
        StateHasChanged();
    }

    private void HandleCardSelected(Guid cardId)
    {
        if (SelectedCardId == cardId)
        {
            SelectedCardId = null;
            AddMessage("کارت لغو شد.");
        }
        else
        {
            SelectedCardId = cardId;
            var card = GameState?.PlayerHand.FirstOrDefault(c => c.Id == cardId);
            AddMessage($"🃏 کارت {card?.ElementSymbol} انتخاب شد. حالا روی صفحه کلیک کنید.");
        }
    }

    private async Task HandleCellClick(CellClickEventArgs param)
    {
        if (!SelectedCardId.HasValue)
        {
            AddMessage("⚠️ ابتدا یک کارت از دست خود انتخاب کنید.");
            return;
        }

        try
        {
            var result = await GameService.PlaceCardAsync(
                SelectedCardId.Value, 
                new PositionDto(param.Row, param.Col));

            if (result.IsSuccess && result.GameState != null)
            {
                GameState = result.GameState;
                SelectedCardId = null;

                if (result.StonedCards.Any())
                {
                    AddMessage($"💥 {result.StonedCards.Count} کارت سنگ شد!");
                }
                else
                {
                    AddMessage("✅ کارت با موفقیت قرار گرفت.");
                }

                if (result.IsWon)
                {
                    AddMessage("🎉 تبریک! شما برنده شدید!");
                }
                else if (result.IsGameOver)
                {
                    AddMessage("💀 بازی به پایان رسید.");
                }
            }
            else
            {
                AddMessage($"❌ {result.ErrorMessage}");
            }
        }
        catch (Exception ex)
        {
            AddMessage($"❌ خطا: {ex.Message}");
        }
    }

    private async Task HandleRemoveStone(RemoveStoneEventArgs? param)
    {
        try
        {
            GameState = await GameService.RemoveStoneAsync(param.StonedCardId, param.BurnedCardIds);
            AddMessage("🗑️ سنگ حذف شد.");
        }
        catch (Exception ex)
        {
            AddMessage($"❌ خطا: {ex.Message}");
        }
    }

    private async Task ClearSavedData()
    {
        await GameService.StartNewGameAsync();
        GameState = null;
        SelectedCardId = null;
        Messages.Clear();
        AddMessage("🧹 همه داده‌ها پاک شد.");
    }

    private void AddMessage(string message)
    {
        Messages.Add($"[{DateTime.Now:HH:mm:ss}] {message}");
        if (Messages.Count > 10)
            Messages.RemoveAt(0);
    }
}