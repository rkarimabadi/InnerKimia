@page "/"
@using InnerKimia.Application.DTOs
@using InnerKimia.Application.Interfaces
@using static InnerKimia.WebAssembly.Pages.GameBoard
@using static InnerKimia.WebAssembly.Pages.StonedCardsPanel

@inject IGameService GameService

<div class="game-container">
    <h1 class="game-title">✨ الِمنیا | ELEMENYA ✨</h1>

    @if (IsLoading)
    {
        <div class="loading">در حال بارگذاری...</div>
    }
    else if (GameState == null)
    {
        <div class="start-screen">
            <p>به بازی عناصر خوش آمدید!</p>
            <button class="btn btn-primary" @onclick="StartNewGame">
                🎮 شروع بازی جدید
            </button>
        </div>
    }
    else
    {
        <GameStatus GameState="GameState" />

        <div class="game-area">
            <div class="board-section">
                <GameBoard GameState="GameState"
                           SelectedCardId="SelectedCardId"
                           SelectedStoneForRemoval="SelectedStoneForRemoval"
                           IsStoneRemovalMode="IsStoneRemovalMode"
                           OnCellClicked="HandleCellClick"
                           OnStoneSelected="HandleStoneSelected" />
                <GameControls GameState="GameState"
                              OnNewGame="StartNewGame"
                              OnClearData="ClearSavedData"
                              OnOpenGuide="OpenGuide" />
            </div>

            <div class="side-panel">
                <PlayerHand GameState="GameState"
                            SelectedCardId="SelectedCardId"
                            SelectedBurnedCardIds="SelectedBurnedCardIds"
                            IsBurnMode="IsStoneRemovalMode"
                            OnCardClicked="HandleCardClick" />

                @*                 <StonedCardsPanel GameState="GameState"
                                  SelectedStoneId="SelectedStoneId"
                                  OnStoneClicked="HandleStoneClickFromPanel" /> *@

            </div>
        </div>

        @if (ShowStoneRemovalConfirm)
        {
            <div class="stone-removal-confirm">
                <div class="confirm-dialog">
                    <p>🔥 آیا مطمئن هستید می‌خواهید این سنگ را با سوزاندن ۲ کارت حذف کنید؟</p>
                    <div class="confirm-buttons">
                        <button class="btn btn-danger" @onclick="ConfirmRemoveStone">✓ تأیید</button>
                        <button class="btn btn-secondary" @onclick="CancelStoneRemoval">✗ انصراف</button>
                    </div>
                </div>
            </div>
        }

        <GameMessages Messages="Messages" />
    }
</div>
<!-- مودال راهنمای بازی -->
<GameGuide IsOpen="@IsGuideOpen" OnClose="@(() => IsGuideOpen = false)" />
@code {
    private GameStateDto? GameState;
    private Guid? SelectedCardId;
    private List<string> Messages = new();
    private bool IsLoading = true;

    // متغیرهای جدید برای فرآیند حذف سنگ
    private Guid? SelectedStoneId;
    private PositionDto? SelectedStoneForRemoval;
    private List<Guid> SelectedBurnedCardIds = new();
    private bool ShowStoneRemovalConfirm = false;
    private Guid PendingStoneIdForRemoval;
    private bool IsStoneRemovalMode = false;
    private bool IsGuideOpen = false;

    private void OpenGuide()
    {
        IsGuideOpen = true;
        StateHasChanged();
    }
    protected override async Task OnInitializedAsync()
    {
        await LoadGameAsync();
    }

    private async Task LoadGameAsync()
    {
        IsLoading = true;
        try
        {
            GameState = await GameService.GetGameStateAsync();
            AddMessage("بازی قبلی بارگذاری شد.");
        }
        catch
        {
            GameState = null;
        }
        IsLoading = false;
    }

    private async Task StartNewGame()
    {
        IsLoading = true;
        try
        {
            GameState = await GameService.StartNewGameAsync();
            SelectedCardId = null;
            ClearStoneRemovalState();
            Messages.Clear();
            AddMessage("🎯 بازی جدید شروع شد! اولین کارت را در مرکز قرار دهید.");
        }
        catch (Exception ex)
        {
            AddMessage($"❌ خطا: {ex.Message}");
        }
        IsLoading = false;
        StateHasChanged();
    }

    private void HandleCardSelected(Guid cardId)
    {
        if (SelectedCardId == cardId)
        {
            SelectedCardId = null;
            AddMessage("کارت لغو شد.");
        }
        else
        {
            SelectedCardId = cardId;
            var card = GameState?.PlayerHand.FirstOrDefault(c => c.Id == cardId);
            AddMessage($"🃏 کارت {card?.ElementSymbol} انتخاب شد. حالا روی صفحه کلیک کنید.");
        }
    }

    // ==================== مدیریت کلیک روی کارت‌ها (هم برای بازی و هم برای سوزاندن) ====================

    private void HandleCardClick(Guid cardId)
    {
        if (IsStoneRemovalMode)
        {
            // در حالت حذف سنگ هستیم
            HandleCardSelectedForBurn(cardId);
        }
        else
        {
            // در حالت عادی بازی هستیم
            HandleCardSelected(cardId);
        }
    }

    // ==================== مدیریت حذف سنگ ====================

    private void HandleStoneSelected(StoneSelectedEventArgs args)
    {
        // اگر در حالت انتخاب کارت برای بازی هستیم، آن را لغو می‌کنیم
        if (SelectedCardId.HasValue)
        {
            SelectedCardId = null;
            AddMessage("⚠️ انتخاب کارت برای بازی لغو شد.");
        }

        // اگر همان سنگ دوباره کلیک شد، انتخاب لغو می‌شود
        if (SelectedStoneId == args.StonedCardId)
        {
            ClearStoneRemovalState();
            AddMessage("انتخاب سنگ لغو شد.");
        }
        else
        {
            SelectedStoneId = args.StonedCardId;
            SelectedStoneForRemoval = new PositionDto(args.Row, args.Col);
            SelectedBurnedCardIds.Clear();
            IsStoneRemovalMode = true; // فعال کردن حالت سوزاندن
            var stonedCard = GameState?.Board.Values.FirstOrDefault(c => c?.Id == args.StonedCardId);
            AddMessage($"🌑 سنگ {stonedCard?.ElementSymbol} انتخاب شد. حالا ۲ کارت از دست خود را برای سوزاندن انتخاب کنید.");
        }
        StateHasChanged();
    }

    private void HandleStoneClickFromPanel(Guid stonedCardId)
    {
        // پیدا کردن موقعیت سنگ
        var stonedCardEntry = GameState?.Board.FirstOrDefault(kvp => kvp.Value?.Id == stonedCardId);
        if (stonedCardEntry.HasValue && stonedCardEntry.Value.Value != null)
        {
            var position = stonedCardEntry.Value.Key.Split(',');
            if (position.Length == 2)
            {
                HandleStoneSelected(new StoneSelectedEventArgs
                    {
                        Row = int.Parse(position[0]),
                        Col = int.Parse(position[1]),
                        StonedCardId = stonedCardId
                    });
            }
        }
    }

    private void HandleCardSelectedForBurn(Guid cardId)
    {
        if (!SelectedStoneId.HasValue)
        {
            AddMessage("⚠️ خطا: سنگ انتخاب شده نامعتبر است. لطفاً دوباره سنگ را انتخاب کنید.");
            ClearStoneRemovalState();
            return;
        }

        if (SelectedBurnedCardIds.Contains(cardId))
        {
            SelectedBurnedCardIds.Remove(cardId);
            var card = GameState?.PlayerHand.FirstOrDefault(c => c.Id == cardId);
            AddMessage($"❌ کارت {card?.ElementSymbol} از لیست سوزاندن حذف شد ({SelectedBurnedCardIds.Count}/2).");
        }
        else if (SelectedBurnedCardIds.Count < 2)
        {
            SelectedBurnedCardIds.Add(cardId);
            var card = GameState?.PlayerHand.FirstOrDefault(c => c.Id == cardId);
            AddMessage($"🔥 کارت {card?.ElementSymbol} به لیست سوزاندن اضافه شد ({SelectedBurnedCardIds.Count}/2).");
        }
        else
        {
            AddMessage("⚠️ قبلاً ۲ کارت انتخاب کرده‌اید. ابتدا عملیات را تأیید یا لغو کنید.");
            return;
        }

        // اگر ۲ کارت انتخاب شد، دیالوگ تأیید نمایش داده شود
        if (SelectedBurnedCardIds.Count == 2)
        {
            PendingStoneIdForRemoval = SelectedStoneId.Value;
            ShowStoneRemovalConfirm = true;
        }

        StateHasChanged();
    }

    private async Task ConfirmRemoveStone()
    {
        ShowStoneRemovalConfirm = false;

        try
        {
            var result = await GameService.RemoveStoneAsync(PendingStoneIdForRemoval, SelectedBurnedCardIds);
            GameState = result;
            AddMessage($"🗑️ سنگ با موفقیت حذف شد و {SelectedBurnedCardIds.Count} کارت سوزانده شد.");
            ClearStoneRemovalState();
        }
        catch (Exception ex)
        {
            AddMessage($"❌ خطا در حذف سنگ: {ex.Message}");
            ClearStoneRemovalState();
        }
    }

    private void CancelStoneRemoval()
    {
        ShowStoneRemovalConfirm = false;
        ClearStoneRemovalState();
        AddMessage("عملیات حذف سنگ لغو شد.");
    }

    private void ClearStoneRemovalState()
    {
        SelectedStoneId = null;
        SelectedStoneForRemoval = null;
        SelectedBurnedCardIds.Clear();
        PendingStoneIdForRemoval = Guid.Empty;
        IsStoneRemovalMode = false;
    }

    // ==================== ادامه متدهای قبلی ====================

    private async Task HandleCellClick(CellClickEventArgs param)
    {
        // اگر در حالت حذف سنگ هستیم، ابتدا آن را لغو می‌کنیم
        if (IsStoneRemovalMode)
        {
            ClearStoneRemovalState();
            AddMessage("حالت حذف سنگ لغو شد. حالا می‌توانید کارت بگذارید.");
        }

        if (!SelectedCardId.HasValue)
        {
            AddMessage("⚠️ ابتدا یک کارت از دست خود انتخاب کنید.");
            return;
        }

        try
        {
            var result = await GameService.PlaceCardAsync(
                SelectedCardId.Value,
                new PositionDto(param.Row, param.Col));

            if (result.IsSuccess && result.GameState != null)
            {
                GameState = result.GameState;
                SelectedCardId = null;

                if (result.StonedCards.Any())
                {
                    AddMessage($"💥 {result.StonedCards.Count} کارت سنگ شد!");
                }
                else
                {
                    AddMessage("✅ کارت با موفقیت قرار گرفت.");
                }

                if (result.IsWon)
                {
                    AddMessage("🎉 تبریک! شما برنده شدید!");
                }
                else if (result.IsGameOver)
                {
                    AddMessage("💀 بازی به پایان رسید.");
                }
            }
            else
            {
                AddMessage($"❌ {result.ErrorMessage}");
            }
        }
        catch (Exception ex)
        {
            AddMessage($"❌ خطا: {ex.Message}");
        }
    }

    private async Task ClearSavedData()
    {
        await GameService.StartNewGameAsync();
        GameState = null;
        SelectedCardId = null;
        ClearStoneRemovalState();
        Messages.Clear();
        AddMessage("🧹 همه داده‌ها پاک شد.");
    }

    private void AddMessage(string message)
    {
        Messages.Add($"[{DateTime.Now:HH:mm:ss}] {message}");
        if (Messages.Count > 10)
            Messages.RemoveAt(0);
    }
}