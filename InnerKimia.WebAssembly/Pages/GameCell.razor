﻿@using InnerKimia.Application.DTOs
@using static InnerKimia.WebAssembly.Pages.GameBoard

<div class="cell @GetCellClass()" @onclick="HandleClick">
    @if (Card != null)
    {
        <div class="card-on-board @(Card.IsStoned ? "stoned" : "")">
            <span class="element-symbol">@Card.ElementSymbol</span>
            @if (Card.IsStoned)
            {
                <span class="stone-icon">🌑</span>
            }
            else
            {
                <span class="element-name">@CardDto.Elements[Card.Element]</span>
            }
        </div>
    }
    else if (CanPlace)
    {
        <div class="empty-cell-placeholder">
            <span>+</span>
        </div>
    }
</div>

@code {
    [Parameter] public CardDto? Card { get; set; }
    [Parameter] public int Row { get; set; }
    [Parameter] public int Col { get; set; }
    [Parameter] public bool IsSelected { get; set; }
    [Parameter] public bool CanPlace { get; set; }
    [Parameter] public bool IsSelectedForStoneRemoval { get; set; }
    [Parameter] public bool IsStoneRemovalMode { get; set; } = false;
    [Parameter] public EventCallback<CellClickEventArgs> OnCellClick { get; set; }
    [Parameter] public EventCallback<StoneSelectedEventArgs> OnStoneSelected { get; set; }

    private string GetCellClass()
    {
        if (Card != null)
        {
            if (Card.IsStoned)
            {
                if (IsSelectedForStoneRemoval) return "cell-occupied cell-stoned stone-selected";
                return "cell-occupied cell-stoned";
            }
            return $"cell-occupied cell-{Card.Element.ToLower()}";
        }

        return CanPlace ? "cell-empty cell-clickable" : "cell-empty";
    }

    private async Task HandleClick()
    {
        if (Card?.IsStoned == true)
        {
            // فقط اگر در حالت حذف سنگ نیستیم یا اگر هستیم باز هم می‌توانیم سنگ جدید انتخاب کنیم
            await OnStoneSelected.InvokeAsync(new StoneSelectedEventArgs
                {
                    Row = Row,
                    Col = Col,
                    StonedCardId = Card.Id
                });
        }
        else if (CanPlace || Card == null)
        {
            await OnCellClick.InvokeAsync(new CellClickEventArgs
                {
                    Row = Row,
                    Col = Col
                });
        }
    }
}