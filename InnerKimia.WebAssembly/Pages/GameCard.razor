﻿@using InnerKimia.Application.DTOs

<div class="game-card @GetCardClass()"
     @onclick="HandleClick"
     @onclick:stopPropagation="true">

    <div class="card-element">
        <span class="element-symbol">@Card.ElementSymbol</span>
        <span class="element-name">@CardDto.Elements[Card.Element]</span>
    </div>

    @if (Card.IsStoned)
    {
        <div class="card-badge badge-stoned">🌑</div>
    }
</div>

@code {
    [Parameter] public CardDto Card { get; set; } = null!;
    [Parameter] public bool IsSelected { get; set; }
    [Parameter] public bool IsSelectedForBurn { get; set; }
    [Parameter] public bool IsBurnMode { get; set; } = false; // حالت سوزاندن
    [Parameter] public EventCallback OnCardClicked { get; set; }

    private string GetCardClass()
    {
        var classes = new List<string> { $"card-{Card.Element.ToLower()}" };

        if (IsSelected)
            classes.Add("card-selected");

        if (IsSelectedForBurn)
            classes.Add("card-burn-selected");

        if (Card.IsStoned)
            classes.Add("card-stoned");

        return string.Join(" ", classes);
    }

    private async Task HandleClick()
    {
        await OnCardClicked.InvokeAsync();
    }
}