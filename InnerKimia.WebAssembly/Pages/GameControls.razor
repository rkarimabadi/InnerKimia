@using InnerKimia.Application.DTOs

<div class="game-controls">
    <button class="btn btn-success" @onclick="HandleNewGame">
        🎮 شروع بازی جدید
    </button>

    @if (GameState != null)
    {
        <button class="btn btn-warning" @onclick="HandleClearData">
            🧹 پاک کردن داده‌ها
        </button>
    }
</div>

@code {
    [Parameter] public GameStateDto? GameState { get; set; }
    [Parameter] public EventCallback OnNewGame { get; set; }
    [Parameter] public EventCallback OnClearData { get; set; }

    private async Task HandleNewGame()
    {
        await OnNewGame.InvokeAsync();
    }

    private async Task HandleClearData()
    {
        await OnClearData.InvokeAsync();
    }
}