﻿@using InnerKimia.Application.DTOs

@if (StonedCards.Any())
{
    <div class="stoned-panel" style="direction:rtl;">
        <h3>🌑 کارت‌های سنگ شده</h3>
        <p class="stone-removal-hint" style="font-size:0.85em; color:#ccc; margin-bottom:10px;">
            💡 برای حذف سنگ، ابتدا روی سنگ مورد نظر کلیک کنید، سپس ۲ کارت از دست خود را انتخاب کنید.
        </p>

        @foreach (var stonedCard in StonedCards)
        {
            var isSelected = SelectedStoneId == stonedCard.Id;
            <div class="stoned-card-item @(isSelected ? "selected-stone" : "")"
                 @onclick="() => OnStoneClicked.InvokeAsync(stonedCard.Id)">
                <div class="game-card card-stoned">
                    <span class="element-symbol">@stonedCard.ElementSymbol</span>
                    <span class="element-name">@CardDto.Elements[stonedCard.Element]</span>
                </div>
                @if (isSelected)
                {
                    <span class="selected-indicator">✓ انتخاب شده</span>
                }
            </div>
        }
    </div>
}

@code {
    [Parameter] public GameStateDto GameState { get; set; } = null!;
    [Parameter] public Guid? SelectedStoneId { get; set; }
    [Parameter] public EventCallback<Guid> OnStoneClicked { get; set; }

    private List<CardDto> StonedCards => GameState.Board.Values
        .Where(c => c != null && c.IsStoned)
        .Select(c => c!)
        .ToList();
}